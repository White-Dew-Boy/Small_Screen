CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Custom partition table: app (factory) enlarged to 8 MB (see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
# PC-Perf page title uses the 20 px Montserrat font
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_USE_LOG=y
# INFO-level LVGL trace floods the UART (thousands of lines/min at
# 115200 baud) and slows the LVGL task; WARN keeps real issues visible.
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
# CONFIG_LV_TICK_CUSTOM is not set

# System Info page: per-task CPU load needs FreeRTOS run-time stats
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Home page clock: allow a second NTP server (pool.ntp.org + ntp.aliyun.com)
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# WiFi credentials are configured at runtime from the LCD UI (stored in NVS),
# not compiled in. Only the retry count is a build-time option here:
# CONFIG_WIFI_MAX_RETRY=10

# Main log channel goes to USB-Serial-JTAG (TypeC, COM5); UART0 is reserved
# for the JY901S IMU (GPIO43/44), so no log bytes leak into its RX line.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PC-Perf page: BLE peripheral (NimBLE) receiving PC performance data.
# ESP32-S3 is BLE-only; disable the unused roles/features to save RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# GAP 默认设备名也设为最终名字(双保险,与 ble_svc_gap_device_name_set() 一致)
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="ESP32_PC_Monitor"
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
# NimBLE host memory pool in PSRAM: internal RAM is tight (WiFi + MQTT/TLS +
# BT controller), and an internal-memory NimBLE pool exhausted it — the LVGL
# task (16 KB internal stack) then failed to start and the screen stayed white.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
